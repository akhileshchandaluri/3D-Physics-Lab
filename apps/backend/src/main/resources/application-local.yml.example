# Example local configuration file.
# Copy this file to application-local.yml and customize with your local secrets.
# application-local.yml is ignored by git and must never be committed.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/physim
    username: postgres
    password: ${DATABASE_PASSWORD:}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
  flyway:
    enabled: true
    baseline-on-migrate: true

app:
  security:
    cookie-name: physim_session
    cookie-secret: dev_secret_cookie_signing_key_at_least_32_chars_long!
    session-ttl-days: 30
  admin:
    initial-email: admin@physim.edu
    initial-password: AdminPassword123!
    initial-name: System Administrator
  oauth2:
    google:
      client-id: dev-google-client-id.apps.googleusercontent.com
      client-secret: dev-fake-google-client-secret
      redirect-uri: http://localhost:5173/oauth/callback
      allowed-redirect-uris: http://localhost:5173/oauth/callback,http://localhost:5174/oauth/callback,http://127.0.0.1:5173/oauth/callback,http://127.0.0.1:5174/oauth/callback
