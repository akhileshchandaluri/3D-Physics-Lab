{
  "name": "kl-physics-lab",
  "version": "1.0.0",
  "private": true,
  "description": "KL Physics Virtual Lab (Monorepo - Java Spring Boot Backend + React Frontend)",
  "workspaces": [
    "apps/frontend",
    "packages/*"
  ],
  "overrides": {
    "three": "0.180.0",
    "@types/three": "0.180.0"
  },
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "mvn -f apps/backend/pom.xml spring-boot:run",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:backend": "mvn -f apps/backend/pom.xml clean package -DskipTests",
    "test": "npm run test:backend",
    "test:backend": "mvn -f apps/backend/pom.xml test",
    "test:frontend": "npm run test --workspace=apps/frontend --if-present",
    "lint": "eslint apps/frontend",
    "format": "prettier --write apps/frontend"
  },
  "keywords": [
    "physics",
    "virtual-lab",
    "react",
    "spring-boot",
    "java",
    "monorepo"
  ],
  "author": "",
  "license": "ISC"
}